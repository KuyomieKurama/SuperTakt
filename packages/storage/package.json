{
  "name": "@takt/storage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Takt — ausgehende Ports und der austauschbare SQLite-Adapter (E-001, E-035).",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./migrations/*": "./migrations/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrations:embed": "node scripts/embed-migrations.mjs",
    "migrations:embed:check": "node scripts/embed-migrations.mjs --check"
  },
  "dependencies": {
    "@takt/domain": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
