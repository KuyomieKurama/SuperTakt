{
  "name": "@takt/outlook-addin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Takt — Outlook-Add-in: Todo aus einer E-Mail anlegen (A-10.*, S-12, S-13).",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "proof:addin": "node --import ./scripts/register-ts-resolve.mjs scripts/proof-addin.mjs"
  },
  "dependencies": {
    "@takt/domain": "workspace:*",
    "@takt/ui-tokens": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
