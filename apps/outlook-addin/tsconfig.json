// Erbt die strengen Schalter von der Wurzel (T-008a). Hier steht nur, was der
// Aufgabenbereich zusaetzlich braucht: JSX, die DOM-Bibliotheken, die Typen des
// Vite-Clients und `WebWorker` — die Erkennung der Call-Nummer laeuft in einem
// Web Worker mit harter Zeitgrenze (B-4.1) und braucht dessen globale Fläche.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts"]
}
