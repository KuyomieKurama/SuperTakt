{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Takt",
  "version": "0.0.0",
  "identifier": "de.takt.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @takt/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @takt/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Takt",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false,

        // ---------------------------------------------------------------
        // NICHT auf `true` setzen (E-043).
        //
        // Mit `true` bedient Tauri den Webview unter Windows und Android
        // ueber `https://tauri.localhost` statt `http://tauri.localhost`.
        // Zwei Dinge brechen dann gleichzeitig:
        //
        // 1. Der Webview verweigert wegen gemischter Inhalte **jede**
        //    Anfrage an `http://127.0.0.1:17843`. Der lokale Dienst ist
        //    damit unerreichbar und die Anwendung laedt gar nichts mehr.
        // 2. `https://tauri.localhost` steht seit E-043 nicht mehr in
        //    ALLOWED_ORIGINS (apps/local-api/src/config.ts). Selbst wenn
        //    der Webview die Anfrage stellte, kaeme sie mit 403 zurueck.
        //
        // Der Eintrag wurde dort gestrichen, weil er im Betrieb nie
        // vorkommen kann, solange dieser Schalter `false` ist — und ein
        // Eintrag in einer Positivliste, den niemand ausloest, ist keine
        // Vorsorge, sondern eine offene Tuer, an die sich niemand mehr
        // erinnert.
        //
        // Wer den Schalter doch umlegt, muss die Herkunft dort bewusst
        // wieder aufnehmen. Genau dieser Zwang ist der Sinn der
        // Streichung. Zusaetzlich waere die CSP unten anzupassen
        // (`connect-src`), und der Wechsel des Schemas verlegt
        // IndexedDB, Cookies und localStorage — bestehende Daten im
        // Webview waeren nicht mehr erreichbar.
        //
        // Im Auslieferungsbau gemessen (T-008b, Linux/WebKitGTK):
        // `Origin: tauri://localhost`. Unter Windows ist es
        // `http://tauri.localhost`.
        // ---------------------------------------------------------------
        "useHttpsScheme": false
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:17843; frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'none'; script-src 'self' 'unsafe-inline' http://localhost:5173; style-src 'self' 'unsafe-inline' http://localhost:5173; img-src 'self' data: http://localhost:5173; font-src 'self' data: http://localhost:5173; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:17843 http://localhost:5173 ws://localhost:5173; frame-ancestors 'none'; object-src 'none'",
      "assetProtocol": {
        "enable": false
      }
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,

    // ---------------------------------------------------------------------
    // Ein Eintrag je Erzeugnis, das ausgeliefert wird (T-075).
    //
    // Tauri filtert diese Liste nach der Plattform, auf der gerade gebaut
    // wird: Unter Windows bleibt `nsis`, unter Linux `deb` und `appimage`,
    // unter macOS `app` und `dmg`. Es ist also **eine** Liste fuer drei
    // Plattformen und keine Fallunterscheidung.
    //
    // `app` und `dmg` kamen mit T-075 dazu. Ohne sie waere unter macOS keiner
    // der Eintraege uebrig geblieben, und `tauri build` haette dort einen
    // Bau ohne Erzeugnis hinterlassen — gruen, mit leerem Ausgabeordner.
    // `app` ist die Anwendung selbst, `dmg` das Abbild, das ein Mensch
    // herunterlaedt; das `dmg` braucht das `app`.
    //
    // `msi` steht bewusst nicht dabei: Der Auslieferungsweg unter Windows ist
    // NSIS (`installMode: currentUser`, kein Administrator noetig). `rpm`
    // ebenso wenig — es ist nie gebaut und nie geprueft worden.
    "targets": ["nsis", "deb", "appimage", "app", "dmg"],
    "publisher": "Takt",

    // Der einzige Urheberrechtshinweis ausserhalb von /LICENSE. Er steht hier,
    // weil Tauri dieses Feld in die Steuerdatei der `.deb` und in die
    // Eigenschaften des NSIS-Installers schreibt: Ein leeres Feld liefert ein
    // Paket aus, das keinen Rechteinhaber nennt, waehrend die MIT-Lizenz
    // verlangt, dass Hinweis und Erlaubnistext jede Kopie begleiten.
    //
    // Wortgleich zu /LICENSE Zeile 3 halten. Weicht der Wert ab, gibt es wieder
    // zwei Aussagen — genau der Fehler, den T-068 in der `Cargo.toml` behoben
    // hat. /LICENSE ist die Quelle, diese Zeile die Kopie.
    "copyright": "Copyright (c) 2026 KuyomieKurama",
    "category": "Productivity",
    "shortDescription": "Todos und Zeiterfassung, vollständig lokal",
    "longDescription": "Takt verwaltet Todos, erfasst Zeiten und erzeugt Exportdateien für die Abrechnung. Alle Daten bleiben auf diesem Rechner.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/takt-local-api"],

    // ---------------------------------------------------------------------
    // Das Buendel des Aufgabenbereichs (E-046, T-054).
    //
    // `apps/local-api/src/taskpane/server.ts` sucht es an genau einem Ort,
    // der in der Auslieferung gilt: `resolve(process.execPath, '..',
    // 'taskpane')` — also **neben der Sidecar-Binaerdatei**. Nicht im
    // Ressourcenverzeichnis von Tauri, sondern neben der Binaerdatei. Diese
    // Unterscheidung ist der ganze Grund fuer die zwei Eintraege unten.
    //
    // Der Ordner `taskpane/` entsteht aus `scripts/build-taskpane.mjs`; er
    // steht in `.gitignore` und ist eine geprueft kopierte Fassung von
    // `apps/outlook-addin/dist`. `scripts/build-app.mjs` bricht ab, wenn er
    // fehlt — ein Paket ohne Aufgabenbereich enthaelt ein Add-in, das beim
    // Kunden nicht startet, und das faellt sonst niemandem auf.
    //
    // **Windows (NSIS) — der Auslieferungsfall.** Dort ist das
    // Ressourcenverzeichnis dasselbe wie das Verzeichnis der ausfuehrbaren
    // Datei: NSIS legt Hauptprogramm, Sidecar und Ressourcen zusammen nach
    // `$INSTDIR`. `resources` trifft also genau den gesuchten Ort.
    //
    // ---------------------------------------------------------------------
    // Der zweite Eintrag: die Lizenzbeilage (T-068, T-075).
    //
    // `licenses/` entsteht aus `scripts/collect-licenses.mjs` und enthaelt
    // `THIRD-PARTY-LICENSES.txt` und eine Kopie von `/LICENSE`. Er steht in
    // `.gitignore`, weil er aus dem Abhaengigkeitsgraphen des jeweiligen Baus
    // erzeugt wird und plattformgebunden ist.
    //
    // Anders als beim Aufgabenbereich braucht es hier **keinen** zweiten
    // Eintrag unter `linux.*.files`: Diese Dateien werden von keinem Programm
    // gesucht, sie muessen nur im Paket liegen. `/usr/lib/Takt/licenses/`
    // reicht dafuer; eine zweite Kopie waeren 730 KiB ohne Gegenwert.
    //
    // `scripts/build-app.mjs` bricht ab, wenn der Ordner fehlt. Ein Paket,
    // das ohne die Lizenztexte weitergegeben wird, sieht vollstaendig aus.
    "resources": ["taskpane/**/*", "licenses/**/*"],

    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German"]
      }
    },
    "linux": {
      // **Linux — der Entwicklungsrechner.** Hier gilt das nicht: Tauri legt
      // Ressourcen nach `/usr/lib/<produktname>/`, die Binaerdateien aber nach
      // `/usr/bin/` (nachzulesen in `tauri_utils::platform::resource_dir`).
      // Der Sidecar wuerde sein Buendel dort nicht finden. Deshalb legen die
      // beiden `files`-Eintraege dieselben Dateien zusaetzlich nach
      // `/usr/bin/taskpane` — und **das** ist die Kopie, die der Dienst liest.
      //
      // Wer einen der Eintraege streicht, weil oben schon `resources` steht,
      // macht das Add-in unter Linux still unbenutzbar. Gemessen im gebauten
      // Paket (T-054): `resources` landet in beiden Erzeugnissen unter
      // `usr/lib/Takt/taskpane`, wo nichts danach sucht; das AppImage erbt den
      // `deb`-Eintrag **nicht**, es braucht seinen eigenen.
      //
      // Der Preis ist eine zweite, tote Kopie von 1,3 MiB in den
      // Linux-Paketen. Sie wird in Kauf genommen, weil die Alternative — den
      // `resources`-Eintrag nur unter Windows zu setzen — bedeuten wuerde,
      // dass die Auslieferungsplattform an einem Zweig haengt, den auf diesem
      // Rechner nie jemand ausfuehrt. Genau diese Sorte Luecke ist T-054.
      "deb": {
        "depends": [],
        "files": {
          "/usr/bin/taskpane": "taskpane"
        }
      },
      "appimage": {
        "files": {
          "/usr/bin/taskpane": "taskpane"
        }
      }
    }
  }
}
